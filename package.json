{
  "name": "toile",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "lint": "oxlint && node scripts/check-brand.mjs",
    "lint:brand": "node scripts/check-brand.mjs",
    "preview": "vite preview",
    "test:migrate": "node scripts/test-migrate.mjs",
    "test:demo": "node scripts/test-demo.mjs",
    "test:art": "node scripts/test-art.mjs",
    "test:smoke": "node scripts/smoke.mjs",
    "shots": "node scripts/screenshot.mjs",
    "verify": "npm run build && npm run lint:brand && npm run test:migrate && npm run test:demo"
  },
  "dependencies": {
    "@tailwindcss/vite": "^4.3.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "react-router-dom": "^7.18.2"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "autoprefixer": "^10.5.4",
    "esbuild": "^0.27.0",
    "oxlint": "^1.75.0",
    "playwright": "^1.58.0",
    "postcss": "^8.5.26",
    "tailwindcss": "^4.3.3",
    "typescript": "~6.0.2",
    "vite": "^8.2.0"
  }
}
